    { "id": "foul", "zh": "犯规", "fields": { "player": "球员id", "victim": "球员id", "danger": "低|中|高" }, "consumers": ["sim", "broadcast", "graphics"] },
    { "id": "card", "zh": "出牌", "fields": { "player": "球员id", "type": "yellow|red", "reason": "标签" }, "consumers": ["sim", "broadcast", "graphics", "audio", "ui"] },
    { "id": "offside", "zh": "越位", "fields": { "player": "球员id" }, "consumers": ["sim", "broadcast", "graphics"] },
    { "id": "injury", "zh": "受伤", "fields": { "player": "球员id", "severity": "轻|中|重" }, "consumers": ["sim", "ui"] },
    { "id": "set_piece_awarded", "zh": "判给定位球", "fields": { "kind": "corner|free_kick|throw_in|penalty|goal_kick", "team": "队id", "origin": "[x,y]" }, "consumers": ["sim", "broadcast", "graphics"] },
    { "id": "set_piece_taken", "zh": "定位球开出", "fields": { "kind": "corner|free_kick|throw_in|penalty|goal_kick", "taker": "球员id", "target": "球员id|区域" }, "consumers": ["sim", "broadcast", "audio"] },
    { "id": "press_trigger", "zh": "逼抢发起", "fields": { "team": "队id", "initiator": "球员id", "zone": "区域", "structure": "1v1|double|shadow" }, "consumers": ["sim", "graphics"] },
    { "id": "run_trigger", "zh": "跑位触发", "fields": { "player": "球员id", "kind": "behind|overlap|underlap|drop|decoy|late_box" }, "consumers": ["sim", "graphics"] },
    { "id": "gk_action", "zh": "门将动作", "fields": { "gk": "球员id", "kind": "claim|punch|parry|distribute|sweep" }, "consumers": ["sim", "broadcast", "audio"] },
    { "id": "substitution", "zh": "换人", "fields": { "team": "队id", "out": "球员id", "in": "球员id", "minute": "分钟", "reason": "tactical|injury|fatigue|losing|protect" }, "consumers": ["sim", "broadcast", "graphics", "audio", "ui"] },
    { "id": "manager_decision", "zh": "AI 经理决策", "fields": { "team": "队id", "kind": "mentality|shape|press|instruction|player_message", "detail": "说明", "reason_tag": "理由标签（字幕/解说素材）" }, "consumers": ["sim", "broadcast", "graphics", "audio", "ui"] },
    { "id": "fatigue_flag", "zh": "体能预警", "fields": { "player": "球员id", "level": "low|critical" }, "consumers": ["sim", "ui"] }
  ]
}
