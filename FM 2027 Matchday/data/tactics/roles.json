      "desc": "更高出击与清球倾向，参与后场传控（策应档=回撤接应形成人数优势）",
      "anchor": { "depth_m": 6, "lateral_m": 0 },
      "on_ball": { "safe_pass": 1.4, "through_ball": 1.1, "one_touch": 1.2 },
      "off_ball": { "drop_between_lines": true },
      "defense": { "press": 0.0, "marking": "zone", "cover": "back_line", "tackle_bias": 1.0 },
      "attrs": { "rushing_out": 0.9, "one_on_ones": 0.9, "gk_first_touch": 1.0, "passing": 0.7, "composure": 0.7 } },

