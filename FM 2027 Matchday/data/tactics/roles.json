{
  "version": "v0.1",
  "comment": "角色库（对应 docs/02 §五）。角色=行为包：锚点偏移 + 有球权重覆盖 + 无球跑位规则 + 防守职责。on_ball/off_ball/attrs 的键均为封闭词表，attrs 键必须与 data/players 的属性列名一致（用于编译器的角色适配度评分）。",
  "vocab": {
    "on_ball": ["through_ball", "safe_pass", "switch_play", "long_diagonal", "dribble", "hold_up", "long_shot", "early_cross", "byline_cross", "cut_inside", "one_touch"],
    "off_ball": ["overlap_run", "underlap_run", "run_behind", "drop_receive", "hold_width", "roam_halfspace", "late_box_arrival", "second_ball_box", "decoy_run", "drop_between_lines"],
    "defense": ["press", "marking", "cover", "tackle_bias"],
    "marking": ["zone", "man", "ball_side"],
    "cover": ["back_line", "dm_screen", "wide_channel", "press_shadow", "none"]
  },
  "roles": [
    { "id": "GK",  "zh": "门将",         "en": "Goalkeeper",          "group": "gk",  "positions": ["GK"],  "duties": ["de"],
      "desc": "标准门将，按门将发球指令出球",
      "anchor": { "depth_m": 0, "lateral_m": 0 },
      "on_ball": { "safe_pass": 1.3, "long_diagonal": 0.9 },
      "off_ball": { "hold_width": false },
      "defense": { "press": 0.0, "marking": "zone", "cover": "back_line", "tackle_bias": 1.0 },
      "attrs": { "one_on_ones": 1.0, "reflexes": 1.0, "handling": 1.0, "communication": 0.8, "kicking": 0.5 } },

