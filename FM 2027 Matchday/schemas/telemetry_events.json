{
  "version": "v0.1",
  "comment": "遥测事件词表（docs/03 §十三 旁路输出）。单一事实来源：仿真核产生的所有事件 type、状态流 events[]、转播导演/图文包装/音频的触发引用（data/presentation/）都必须 ⊆ 本词表。consumers 取值：sim 仿真遥测 / broadcast 转播导演 / graphics 图文包装 / audio 音频 / ui 界面。",
  "events": [
    { "id": "match_phase_change", "zh": "比赛阶段切换", "fields": { "from": "phase", "to": "phase" }, "consumers": ["sim", "broadcast", "graphics"] },
    { "id": "pass_attempt", "zh": "传球尝试", "fields": { "from": "球员id", "to": "球员id", "intent": "safe|through|switch|long|cross", "quality": "0-1" }, "consumers": ["sim", "broadcast", "graphics"] },
    { "id": "pass_completed", "zh": "传球完成", "fields": { "from": "球员id", "to": "球员id" }, "consumers": ["sim", "graphics"] },
    { "id": "turnover", "zh": "球权转换", "fields": { "possession_from": "队id", "possession_to": "队id", "zone": "区域", "cause": "tackle|interception|bad_touch|out_of_play" }, "consumers": ["sim", "broadcast", "graphics"] },
    { "id": "interception", "zh": "拦截", "fields": { "player": "球员id" }, "consumers": ["sim", "graphics"] },
    { "id": "ball_recovery", "zh": "夺回球权", "fields": { "player": "球员id", "zone": "区域", "source": "counter_press|tackle|interception|loose" }, "consumers": ["sim", "graphics"] },
    { "id": "shot", "zh": "射门", "fields": { "shooter": "球员id", "origin": "[x,y]", "outcome": "on_target|off_target|blocked|saved|goal", "xg": "0-1", "prep_time": "秒", "body_part": "foot|head|other" }, "consumers": ["sim", "broadcast", "graphics", "audio"] },
    { "id": "goal", "zh": "进球", "fields": { "scorer": "球员id", "assister": "球员id|null", "phase": "open_play|set_piece|counter", "xg": "0-1" }, "consumers": ["sim", "broadcast", "graphics", "audio", "ui"] },
    { "id": "save", "zh": "扑救", "fields": { "gk": "球员id", "shot_ref": "关联 shot 事件", "handled": "caught|parried|deflected" }, "consumers": ["sim", "broadcast", "audio", "ui"] },
